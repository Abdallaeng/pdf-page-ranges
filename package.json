{
  "name": "pdf-page-ranges",
  "version": "1.0.0",
  "description": "Parse and normalise page-range input like \"1-3, 5, 8-\" with clear errors and warnings, and plan PDF splits (by ranges, every N pages, or each page). Zero dependencies.",
  "keywords": [
    "pdf",
    "page-range",
    "page-ranges",
    "parser",
    "split-pdf",
    "extract-pages",
    "print-range",
    "range-parser",
    "pages",
    "typescript"
  ],
  "license": "MIT",
  "author": "Technical Design Team",
  "homepage": "https://pdfnova-desk.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdallaeng/pdf-page-ranges"
  },
  "bugs": {
    "url": "https://github.com/Abdallaeng/pdf-page-ranges/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
